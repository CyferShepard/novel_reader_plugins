{
  "url": "https://freewebnovel.com${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "url",
      "element": ".cur.cur-1>.wp>a",
      "getContent": true,
      "withHref": true,
      "selectItemsAtIndex": [2]
    },
    {
      "label": "cover",
      "element": ".m-imgtxt>.pic>img",
      "getContent": true,
      "withHref": true,
      "transformProcess": "(value)=>{\n        if (value.startsWith(\"/files\")) {\n          return \"https://freewebnovel.com\" + value;\n        } else {\n          return value;\n        }\n      }"
    },
    {
      "label": "title",
      "element": ".cur.cur-1>.wp>a",
      "getContent": true,
      "withHref": false,
      "selectItemsAtIndex": [2]
    },
    {
      "label": "summary",
      "element": ".m-desc>.txt>.inner>p",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "tags",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "author",
      "element": "span[title=\"Author\"] + div > a",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "status",
      "element": "span[title=\"Status\"] + div > span> a",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "genres",
      "element": "span[title=\"Genre\"] + div > a",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "chapters",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "lastUpdate",
      "element": ".lastupdate",
      "getContent": true,
      "withHref": false,
      "regex": {
        "regex": "Updated\\s+([^\\]]+)",
        "process": "(match)=>match && match.length >= 2 ? match[1] : null"
      }
    }
  ]
}
