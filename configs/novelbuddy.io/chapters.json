{
  "url": " https://api.novelbuddy.io/titles/${BookId}/chapters",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "chapters",
      "element": "data.chapters",
      "getContent": true,
      "withHref": false,
      "subQuery": [
        {
          "label": "url",
          "element": "url",
          "getContent": true,
          "withHref": true
        },
        {
          "label": "index",
          "element": "slug",
          "getContent": true,
          "withHref": false,
          "dataProp": "",
          "transformProcess": "(value) => {\n  if (value) {\n    try {\n      const match = value.match(/^chapter-(\\d+)/);\n\n      if (match) {\n       const chapterNum = match[1]; \n       return  parseInt(chapterNum);\n      } else {\n        return null;;\n      }\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n}"
        },
        {
          "label": "title",
          "element": "name",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "date",
          "element": "updated_at",
          "getContent": true,
          "withHref": false
        }
      ]
    },
    {
      "label": "curentPage",
      "element": "null",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "lastPage",
      "element": "null",
      "getContent": true,
      "withHref": false
    }
  ]
}