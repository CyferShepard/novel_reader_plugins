{
  "url": "https://novelbuddy.io${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "novelTitle",
      "element": ".comic-detail>h1",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "novelUrl",
      "element": ".comic-detail>h1>a",
      "getContent": true,
      "withHref": true
    },
    {
      "label": "title",
      "element": ".comic-detail>h2>a>span",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "content",
      "element": ".novel-tts-content p",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "previousPage",
      "element": "div.flex.justify-center.gap-2 a:first-child[href*=\"/chapter-\"]",
      "getContent": true,
      "withHref": true
    },
    {
      "label": "nextPage",
      "element": "div.flex.justify-center.gap-2 a:last-child[href*=\"/chapter-\"]",
      "getContent": false,
      "withHref": true
    },
    {
      "label": "url",
      "element": ".comic-detail>h2>a",
      "getContent": false,
      "withHref": true,
      "regex": {
        "process": ""
      }
    }
  ]
}