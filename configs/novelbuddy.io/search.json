{
  "url": "https://api.novelbuddy.io/titles/search?page=${1}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "results",
      "element": "data.items",
      "getContent": true,
      "withHref": false,
      "subQuery": [
        {
          "label": "url",
          "element": "url",
          "getContent": true,
          "withHref": true
        },
        {
          "label": "title",
          "element": "name",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "summary",
          "element": "alt_name",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "cover",
          "element": "cover",
          "getContent": true,
          "withHref": false,
          "dataProp": "data-src",
          "regex": {
            "process": ""
          },
          "transformProcess": "(value)=>{\n            if (value.startsWith(\"//\")) {\n              return \"https:\"+ value;\n            } else {\n              return value;\n            }\n          }"
        },
        {
          "label": "genres",
          "element": "",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "chapterCount",
          "element": "stats.chapters_count",
          "getContent": true,
          "withHref": false
        }
      ]
    },
    {
      "label": "currentPage",
      "element": "data.pagination.page",
      "getContent": true,
      "withHref": false,
      "transformProcess": "(value) => (!isNaN(value) ? parseInt(value) : null)"
    },
    {
      "label": "lastPage",
      "element": "data.pagination.total_pages",
      "getContent": true,
      "withHref": false
    }
  ]
}