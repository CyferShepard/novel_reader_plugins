{
  "url": "https://novelbuddy.io${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 100,
  "query": [
    {
      "label": "url",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "cover",
      "element": ".manga-details-content>div>div>a>img",
      "getContent": true,
      "withHref": false,
      "dataProp": "src",
      "selectItemsAtIndex": [0]
    },
    {
      "label": "title",
      "element": ".manga-details-content>div>div>a>img",
      "getContent": true,
      "withHref": false,
      "dataProp": "alt",
      "selectItemsAtIndex": [0]
    },
    {
      "label": "summary",
      "element": "[class^=\"MangaDetails_descriptionWrapper\"]",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "tags",
      "element": ".tag-item>span",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "author",
      "element": "[class^=\"MangaDetails_mangaAuthors\"]",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "status",
      "element": "[class^=\"MangaDetails_statItem\"]>span",
      "getContent": true,
      "withHref": false,
      "selectItemsAtIndex": [3]
    },
    {
      "label": "genres",
      "element": "a[href^=\"/genres/\"]",
      "getContent": true,
      "withHref": false,
      "regex": {
        "regex": "",
        "process": ""
      }
    },
    {
      "label": "chapters",
      "element": "button[role=\"tab\"] [class*=\"MangaDetails_tabBadge\"]",
      "getContent": true,
      "withHref": false,
      "selectItemsAtIndex": [0],
      "finalTransformProcess": "(value) => {\n  if (value) {\n    try {\n     const cleanValue = value.replace(/,/g, \"\");\n      return  cleanValue;\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n}"
    },
    {
      "label": "lastUpdate",
      "element": "div.opacity-70>span>span",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "additionalProps",
      "element": "body",
      "getContent": true,
      "withHref": false,
      "subQuery": [
        {
          "label": "BookId",
          "element": "#__NEXT_DATA__",
          "getContent": true,
          "withHref": false,
          "finalTransformProcess": "(value) => {\n  if (value) {\n    try {\n    const data = JSON.parse(value);\nconst bookId = data.props.pageProps.initialManga.id;\n      return bookId;\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n}"
        }
      ]
    }
  ]
}
