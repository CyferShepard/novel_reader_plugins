{
  "url": "https://api.novelbuddy.io/titles/search?sort=latest&page=${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "results",
      "element": "data.items",
      "getContent": true,
      "withHref": false,
      "subQuery": [
        {
          "label": "url",
          "element": "url",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "title",
          "element": "name",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "summary",
          "element": "",
          "getContent": false,
          "withHref": false
        },
        {
          "label": "cover",
          "element": "cover",
          "getContent": false,
          "withHref": false,
          "dataProp": "",
          "regex": {
            "process": ""
          }
        },
        {
          "label": "genres",
          "element": "",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "chapterCount",
          "element": "stats.chapters_count",
          "getContent": false,
          "withHref": false
        }
      ]
    },
    {
      "label": "currentPage",
      "element": "data.pagination.page",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "lastPage",
      "element": "data.pagination.total_pages",
      "getContent": true,
      "withHref": false,
      "dataProp": ""
    }
  ]
}
