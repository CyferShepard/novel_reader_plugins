{
  "url": "https://novelbuddy.io/latest?page=${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "results",
      "element": "div.flex.flex-col.h-full",
      "getContent": true,
      "withHref": false,
      "subQuery": [
        {
          "label": "url",
          "element": "a.absolute",
          "getContent": true,
          "withHref": true
        },
        {
          "label": "title",
          "element": "a.text-base-content",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "summary",
          "element": "a.text-base-content",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "cover",
          "element": "a.absolute>img",
          "getContent": true,
          "withHref": false,
          "dataProp": "src",
          "regex": {
            "process": ""
          }
        },
        {
          "label": "genres",
          "element": "",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "chapterCount",
          "getContent": true,
          "withHref": false
        }
      ]
    },
    {
      "label": "currentPage",
      "element": "div> .btn-accent",
      "getContent": true,
      "withHref": false,
      "transformProcess": "(value) => (!isNaN(value) ? parseInt(value) : null)"
    },
    {
      "label": "lastPage",
      "element": "div> .btn-md",
      "getContent": true,
      "withHref": false,
      "finalTransformProcess": "(value) => {\n  if (value) {\n    try {\n      return parseInt(value[value.length - 1]);\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n}"
    }
  ]
}