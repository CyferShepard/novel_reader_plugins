{
  "url": "${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "novelTitle",
      "element": ".novel-title",
      "getContent": true,
      "withHref": false,
      "dataProp": "title"
    },
    {
      "label": "novelUrl",
      "element": ".novel-title",
      "getContent": false,
      "withHref": true
    },
    {
      "label": "title",
      "element": ".chr-title",
      "getContent": true,
      "withHref": false,
      "dataProp": "title"
    },
    {
      "label": "content",
      "element": "#chr-content>p",
      "getContent": true,
      "withHref": false
    },
    {
      "label": "previousPage",
      "element": "#prev_chap",
      "getContent": false,
      "withHref": true,
      "transformProcess": "(value) => value.includes(\"/null\") ? null : value"
    },
    {
      "label": "nextPage",
      "element": "#next_chap",
      "getContent": false,
      "withHref": true,
      "transformProcess": "(value) => value.includes(\"/null\") ? null : value"
    },
    {
      "label": "url",
      "element": ".chr-title",
      "getContent": false,
      "withHref": true
    }
  ]
}