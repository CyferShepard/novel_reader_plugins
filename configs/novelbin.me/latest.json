{
  "url": "https://novelbin.me/sort/novelbin-daily-update?page=${0}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 100,
  "waitForElement": "",
  "query": [
    {
      "label": "results",
      "element": ".row",
      "getContent": true,
      "withHref": false,
      "dataProp": "",
      "subQuery": [
        {
          "label": "url",
          "element": ".novel-title>a",
          "getContent": true,
          "withHref": true
        },
        {
          "label": "title",
          "element": ".novel-title>a",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "summary",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "cover",
          "element": ".cover",
          "getContent": true,
          "withHref": false,
          "dataProp": "data-src",
          "transformProcess": "(value)=>{\n            if (value.startsWith(\"/\")) {\n              return \"https://novelbin.me\" + value.replace('/novel_200_89','/novel');\n            } else {\n              return value.replace('/novel_200_89','/novel');\n            }\n          }"
        },
        {
          "label": "genres",
          "getContent": true,
          "withHref": false
        },
        {
          "label": "chapterCount",
          "getContent": true,
          "withHref": false
        }
      ]
    },
    {
      "label": "currentPage",
      "element": ".pagination.pagination-sm>.active>a>span",
      "getContent": true,
      "withHref": false,
      "dataProp": "",
      "regex": {
        "regex": "",
        "process": ""
      },
      "transformProcess": "(value) => (!isNaN(value) ? parseInt(value) : null)"
    },
    {
      "label": "lastPage",
      "element": ".pagination.pagination-sm>.last>a",
      "getContent": false,
      "withHref": true,
      "dataProp": "",
      "regex": {
        "regex": "[?&]page=(\\d+)",
        "process": "(match)=>match && match.length >= 2 ? parseInt(match[1]) : null"
      }
    }
  ]
}