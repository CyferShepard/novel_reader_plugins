{
  "url": "https://novelbin.me/ajax/chapter-archive?novelId=${NovelId}",
  "type": "GET",
  "bodyType": "JSON",
  "waitForPageLoad": false,
  "waitDuration": 5000,
  "query": [
    {
      "label": "chapters",
      "element": "[data-chapter-item-template]",
      "subElements": ["li"],
      "getContent": true,
      "withHref": false,
      "subQuery": [
        {
          "label": "url",
          "element": "a",
          "subElements": [],
          "getContent": true,
          "withHref": true
        },
        {
          "label": "index",
          "element": "a",
          "subElements": [],
          "getContent": true,
          "withHref": false,
          "dataProp": "title",
          "regex": {
            "regex": "(?:Chapter\\s+)?(\\d+)",
            "process": "(match)=>match && match.length >= 2 ? parseInt(match[1]) : null"
          }
        },
        {
          "label": "title",
          "element": "a",
          "subElements": [],
          "getContent": true,
          "withHref": false,
          "dataProp": "title"
        },
        {
          "label": "date",
          "subElements": [],
          "getContent": true,
          "withHref": false
        }
      ]
    },
    {
      "label": "curentPage",
      "element": "",
      "subElements": [],
      "getContent": true,
      "withHref": false,
      "dataProp": ""
    },
    {
      "label": "lastPage",
      "element": "",
      "subElements": [],
      "getContent": true,
      "withHref": false,
      "dataProp": ""
    }
  ]
}
